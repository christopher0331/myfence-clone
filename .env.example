# Per-page lead analytics
# ------------------------------------------------------------------
# Logical site identifier baked into every analytics event + form_id.
# Use "myfence" here; the seattlefence.com deployment should set "seattlefence".
NEXT_PUBLIC_SITE_ID=myfence

# Service role key for the Supabase project (server-only, NEVER expose to the client).
# Used by the /admin/analytics dashboard to read aggregated page_events.
# The track-event edge function receives its own SUPABASE_SERVICE_ROLE_KEY automatically.
SUPABASE_SERVICE_ROLE_KEY=

# Secret required to view the /admin/analytics dashboard: visit /admin/analytics?key=THIS_VALUE
ANALYTICS_DASHBOARD_SECRET=

# Existing server-side lead webhook config (unrelated to analytics)
# WEBSITE_LEADS_API=
# WEBSITE_LEADS_WEBHOOK_URL=
