# Per-page lead analytics
# ------------------------------------------------------------------
# Logical client/site slug baked into every analytics event + form_id.
# This MyFence deploy uses "myfence". Other companies get their own slug
# (nawslaw, texas-best, lanehbs, seattlefence, …) on their own deploy.
NEXT_PUBLIC_SITE_ID=myfence

# PostHog: billed Reactiv Labs organization, one project per client.
# Same login; switch projects in the top-left picker. Never reuse another
# client's phc_ token. Leave unset on a site that should not load PostHog.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Service role key for the Supabase project (server-only, NEVER expose to the client).
# Used by the /admin/analytics dashboard to read aggregated page_events.
# The track-event edge function receives its own SUPABASE_SERVICE_ROLE_KEY automatically.
SUPABASE_SERVICE_ROLE_KEY=

# Secret required to view the /admin/analytics dashboard: visit /admin/analytics?key=THIS_VALUE
ANALYTICS_DASHBOARD_SECRET=

# Existing server-side lead webhook config (unrelated to analytics)
# WEBSITE_LEADS_API=
# WEBSITE_LEADS_WEBHOOK_URL=
